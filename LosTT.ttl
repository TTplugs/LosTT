@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mod: <http://moddevices.com/ns/mod#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:ttlab:lv2:lostt>
    a lv2:Plugin ;
    doap:name "LosTT" ;
    doap:license "GPL-2.0-only" ;
    doap:maintainer [ foaf:name "TTLab" ] ;
    mod:brand "TTLab" ;
    mod:label "LosTT" ;
    lv2:minorVersion 0 ;
    lv2:microVersion 3 ;
    lv2:port
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L" ] ,
        [ a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L" ] ,
        [ a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R" ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 4 ;
            lv2:symbol "model" ;
            lv2:name "Model" ;
            lv2:default 0.0 ;
            lv2:minimum 0.0 ;
            lv2:maximum 11.0 ;
            lv2:scalePoint [ rdfs:label "VHS" ; rdf:value 0.0 ] ;
            lv2:scalePoint [ rdfs:label "Porter Studio" ; rdf:value 1.0 ] ;
            lv2:scalePoint [ rdfs:label "Camcorder" ; rdf:value 2.0 ] ;
            lv2:scalePoint [ rdfs:label "Dictaphones" ; rdf:value 3.0 ] ;
            lv2:scalePoint [ rdfs:label "Kids' Toy Tape Machine" ; rdf:value 4.0 ] ;
            lv2:scalePoint [ rdfs:label "Sony Walkman" ; rdf:value 5.0 ] ;
            lv2:scalePoint [ rdfs:label "Broken" ; rdf:value 6.0 ] ;
            lv2:scalePoint [ rdfs:label "Reel-To-Reel" ; rdf:value 7.0 ] ;
            lv2:scalePoint [ rdfs:label "VCR 2" ; rdf:value 8.0 ] ;
            lv2:scalePoint [ rdfs:label "Cassette 2" ; rdf:value 9.0 ] ;
            lv2:scalePoint [ rdfs:label "Cassette 3" ; rdf:value 10.0 ] ;
            lv2:scalePoint [ rdfs:label "Digital" ; rdf:value 11.0 ]
        ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 5 ; lv2:symbol "wow" ; lv2:name "Wow" ; lv2:default 0.35 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 6 ; lv2:symbol "flutter" ; lv2:name "Flutter" ; lv2:default 0.30 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 7 ; lv2:symbol "saturate" ; lv2:name "Saturate" ; lv2:default 0.40 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 8 ; lv2:symbol "failure" ; lv2:name "Failure" ; lv2:default 0.30 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 9 ; lv2:symbol "volume" ; lv2:name "Volume" ; lv2:default 0.50 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 10 ;
            lv2:symbol "dry" ;
            lv2:name "Dry" ;
            lv2:default 0.0 ;
            lv2:minimum 0.0 ;
            lv2:maximum 2.0 ;
            lv2:scalePoint [ rdfs:label "None" ; rdf:value 0.0 ] ;
            lv2:scalePoint [ rdfs:label "Small" ; rdf:value 1.0 ] ;
            lv2:scalePoint [ rdfs:label "Unity" ; rdf:value 2.0 ]
        ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 11 ;
            lv2:symbol "noise" ;
            lv2:name "Noise" ;
            lv2:default 1.0 ;
            lv2:minimum 0.0 ;
            lv2:maximum 2.0 ;
            lv2:scalePoint [ rdfs:label "None" ; rdf:value 0.0 ] ;
            lv2:scalePoint [ rdfs:label "Mild" ; rdf:value 1.0 ] ;
            lv2:scalePoint [ rdfs:label "Heavy" ; rdf:value 2.0 ]
        ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 12 ;
            lv2:symbol "aux_mode" ;
            lv2:name "AUX Mode" ;
            lv2:default 0.0 ;
            lv2:minimum 0.0 ;
            lv2:maximum 2.0 ;
            lv2:scalePoint [ rdfs:label "Stop" ; rdf:value 0.0 ] ;
            lv2:scalePoint [ rdfs:label "Filter" ; rdf:value 1.0 ] ;
            lv2:scalePoint [ rdfs:label "Fail" ; rdf:value 2.0 ]
        ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 13 ; lv2:symbol "aux_active" ; lv2:name "AUX Active" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 14 ; lv2:symbol "aux_onset" ; lv2:name "AUX Onset" ; lv2:default 0.20 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 15 ; lv2:symbol "spread" ; lv2:name "Spread" ; lv2:default 0.45 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 16 ; lv2:symbol "dry_type" ; lv2:name "Dry Type" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 17 ; lv2:symbol "drop_bypass" ; lv2:name "Drop Bypass" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 18 ; lv2:symbol "snag_bypass" ; lv2:name "Snag Bypass" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 19 ; lv2:symbol "hum_bypass" ; lv2:name "Hum Bypass" ; lv2:default 0.0 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 20 ; lv2:symbol "hiss_level" ; lv2:name "Hiss Level" ; lv2:default 0.50 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 21 ; lv2:symbol "mech_level" ; lv2:name "Mechanical Noise Level" ; lv2:default 0.50 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 22 ; lv2:symbol "mech_type" ; lv2:name "Mechanical Noise Type" ; lv2:default 0.0 ; lv2:minimum -1.0 ; lv2:maximum 1.0 ] ,
        [ a lv2:InputPort , lv2:ControlPort ; lv2:index 23 ; lv2:symbol "crinkle_pop_level" ; lv2:name "Crinkle Pop Level" ; lv2:default 0.45 ; lv2:minimum 0.0 ; lv2:maximum 1.0 ] ,
        [
            a lv2:InputPort , lv2:ControlPort ;
            lv2:index 24 ;
            lv2:symbol "input_gain_mode" ;
            lv2:name "Input Gain Mode" ;
            lv2:default 1.0 ;
            lv2:minimum 0.0 ;
            lv2:maximum 2.0 ;
            lv2:scalePoint [ rdfs:label "Line" ; rdf:value 0.0 ] ;
            lv2:scalePoint [ rdfs:label "Instrument" ; rdf:value 1.0 ] ;
            lv2:scalePoint [ rdfs:label "High Gain" ; rdf:value 2.0 ]
        ] .
